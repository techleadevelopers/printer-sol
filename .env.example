# Example values only. Never commit real keys, tokens, or credentials.
HTTP_ADDR=:8080
# Comma-separated browser origins permitted to call the API. The production
# dashboard is allowed by default; add preview domains explicitly when needed.
CORS_ALLOWED_ORIGINS=https://solana-sniper-bot-dashboard.vercel.app
# Production (Railway): use two different PostgreSQL databases. Never reuse a
# simulation ledger for capital real; startup refuses equal or missing URLs.
SIMULATION_DATABASE_URL=
REAL_DATABASE_URL=
# Local SQLite fallback is allowed only for simulation. Live mode refuses to
# start without the two separate PostgreSQL URLs above, preventing paper data
# from ever appearing in the real-operation console.
DATABASE_PATH=./data/sniper.db
PUMPPORTAL_URL=https://pumpportal.fun/api/trade-local
PUMPPORTAL_WS=wss://pumpportal.fun/api/data
RPC_ENDPOINTS=https://api.mainnet.solana.com,https://solana-rpc.publicnode.com,https://rpc.ankr.com/solana,https://solana.drpc.org,https://api.mainnet-beta.solana.com

# SOL/USD quote used to size TRADE_USD (cached up to 30 seconds). An unavailable
# refresh after expiry blocks entries.
SOL_USD_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=solana&vs_currencies=usd

# Safe to expose; the private key is loaded at runtime from the configured secret provider.
WALLET_PUBLIC_ADDRESS=REPLACE_WITH_PUBLIC_WALLET_ADDRESS
KEY_PROVIDER_REF=cloud-env://BOT_PRIVATE_KEY
BOT_PRIVATE_KEY=
# Required in simulation too: per-token price updates drive virtual exits.
PUMPPORTAL_API_KEY=REPLACE_WITH_PUMPPORTAL_API_KEY
# Master password for the console. Set this only in the cloud secret manager.
ADMIN_PASSWORD=

# Simulation is the default. Real trading requires explicit enablement and all required live fields.
SIMULATION=true
ENABLE_LIVE_TRADING=false
# Live startup is blocked unless the separate paper database meets all readiness checks:
# >=7 days, >=100 closed trades, positive net P&L/expectancy, >=45% wins and clean exits.
LIVE_UNLOCK_REQUIRES_PAPER=true
# RugCheck always runs asynchronously after entry and never delays the buy.
# A failed screen raises an alert; TP/SL/trailing/max-hold remain in control.
# Fast mode skips RPC simulation; an invalid transaction can still consume fees.
SKIP_PREFLIGHT=true
# Paper bankroll used only while SIMULATION=true. It is never read from a
# wallet and no transaction is signed or submitted in this mode.
# The values below are a fast-entry sniper profile, not a profitability
# guarantee. Test in simulation and review every risk limit before live use.
SIMULATION_BALANCE_SOL=1
SIMULATION_BASE_FEE_SOL=0.000005

MAX_TRADE_SOL=0.035
MAX_DAILY_LOSS_SOL=0.15
FEE_RESERVE_SOL=0.02
MAX_EXPOSURE_SOL=0.5
MAX_OPEN_POSITIONS=20
MAX_SLIPPAGE_PCT=15
MAX_PRIORITY_FEE_SOL=0.001
MAX_CONFIRMATION_WAIT_SECONDS=12
# Total send attempts; retries rebroadcast the same signed transaction.
MAX_SUBMISSION_ATTEMPTS=3
TOKEN_QUEUE_SIZE=1024
# Concurrent entry workers, per-snipe timeout, and duplicate suppression window.
SNIPE_CONCURRENCY=4
SNIPE_TIMEOUT_MS=15000
DEDUPE_TTL_MS=60000
# Minimum period between RPC health probes while the worker runs continuously.
RPC_HEALTH_CHECK_INTERVAL_SECONDS=45

# A new Pump.fun mint waits this long before the activity gate runs. The gate
# requires this many WebSocket trades, minimum observed buy volume, a positive
# market cap at or above the configured floor, and no creator sell in-window.
ENTRY_DELAY_SECONDS=5
MIN_TXNS_BEFORE_BUY=2
MIN_VOLUME_BEFORE_BUY=0.02
MIN_MARKET_CAP_SOL=20
# Refresh open-position market caps directly from Solana RPC bonding-curve data.
PRICE_POLL_SECONDS=20

# Live mode requires an explicit TRADE_USD. Token age must exceed the entry
# delay so delayed candidates are not rejected before their activity check.
# The strategy still rejects tokens older than five minutes.
TRADE_USD=3
TAKE_PROFIT_GROSS_PCT=50
TOKEN_MAX_AGE_SECONDS=30
NO_REENTRY=true
TRAILING_STOP_PCT=12

# Required before enabling live trading; live trade notional must be explicitly chosen.
STOP_LOSS_PCT=25
MAX_HOLD_SECONDS=300
