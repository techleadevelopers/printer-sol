# Example values only. Never commit real keys, tokens, or credentials.
HTTP_ADDR=:8080
# Production (Railway): create a PostgreSQL service and reference its DATABASE_URL here.
# Example: DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=
# Local SQLite fallback only. DATABASE_URL takes precedence when it is set.
DATABASE_PATH=./data/sniper.db
PUMPPORTAL_URL=https://pumpportal.fun/api/trade-local
PUMPPORTAL_WS=wss://pumpportal.fun/api/data
RPC_ENDPOINTS=https://api.mainnet.solana.com,https://solana-rpc.publicnode.com,https://rpc.ankr.com/solana,https://solana.drpc.org,https://api.mainnet-beta.solana.com

# Fresh SOL/USD quote used to size TRADE_USD. An unavailable quote blocks entries.
SOL_USD_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=solana&vs_currencies=usd

# Safe to expose; the private key is loaded at runtime from the configured secret provider.
WALLET_PUBLIC_ADDRESS=REPLACE_WITH_PUBLIC_WALLET_ADDRESS
KEY_PROVIDER_REF=cloud-env://BOT_PRIVATE_KEY
BOT_PRIVATE_KEY=
PUMPPORTAL_API_KEY=REPLACE_WITH_PUMPPORTAL_API_KEY
ADMIN_API_TOKEN=
ADMIN_PASSWORD=

# Simulation is the default. Real trading requires explicit enablement and all required live fields.
SIMULATION=true
ENABLE_LIVE_TRADING=false

MAX_TRADE_SOL=0.05
MAX_DAILY_LOSS_SOL=0.20
FEE_RESERVE_SOL=0.01
MAX_EXPOSURE_SOL=0.20
MAX_OPEN_POSITIONS=3
MAX_SLIPPAGE_PCT=10
MAX_PRIORITY_FEE_SOL=0.01
MAX_CONFIRMATION_WAIT_SECONDS=45
MAX_SUBMISSION_ATTEMPTS=1
TOKEN_QUEUE_SIZE=1024

# One-shot new-token strategy. A mint may receive only one buy attempt.
TRADE_USD=1
TAKE_PROFIT_GROSS_PCT=70
TOKEN_MAX_AGE_SECONDS=5
NO_REENTRY=true

# Required before enabling live trading: the exit for a token that never reaches take profit.
STOP_LOSS_PCT=REQUIRED_BEFORE_LIVE_TRADING
MAX_HOLD_SECONDS=REQUIRED_BEFORE_LIVE_TRADING
